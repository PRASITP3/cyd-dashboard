# Copy this file to .env and fill in your values

# Admin API key — แสดงยอด token ทั้งหมดจาก Anthropic โดยตรง (แนะนำ)
# สร้างได้ที่ console.anthropic.com/settings/admin-keys
ANTHROPIC_ADMIN_KEY=sk-ant-admin...

# Regular API key — สำหรับ proxy endpoint /api/claude/messages (optional)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Port
PORT=3000
