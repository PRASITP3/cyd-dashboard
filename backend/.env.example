# Copy this file to .env and fill in your values

# Admin API key — แสดงยอด token ทั้งหมดจาก Anthropic โดยตรง (แนะนำ)
# สร้างได้ที่ console.anthropic.com/settings/admin-keys
ANTHROPIC_ADMIN_KEY=sk-ant-admin...

# Regular API key — สำหรับ proxy endpoint /api/claude/messages (optional)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Port
PORT=3000

# ── Supabase (time-capital project) — shared store for Claude Code usage ───────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# anon / publishable key — READ only. Goes in Vercel (the dashboard reads with it).
SUPABASE_ANON_KEY=

# service_role (secret) key — WRITE. Used ONLY by the local uploader (upload-cc.js).
# Keep on your PC. Do NOT put in Vercel and do NOT commit.
SUPABASE_SERVICE_KEY=

# How often upload-cc.js --watch re-pushes (ms). Default 5 min.
UPLOAD_INTERVAL_MS=300000

# ── Stock watchlist (/api/stocks) ─────────────────────────────────────────────
# Fallback list used only when the Supabase stock_watchlist table is empty.
# Thai SET/DR symbols use the .BK suffix (Yahoo Finance).
STOCK_SYMBOLS=GOOG80.BK,AMZN80.BK,LVMH01.BK,ICHI.BK,SMIC23.BK,TENCENT80.BK,MICRON80.BK,CPN.BK,AP.BK,LLY80.BK,CATL01.BK,SISB.BK,AU.BK
